{
  "name": "mem0-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read and search a mem0 OSS memory store held in Qdrant. No backend, no telemetry.",
  "keywords": [
    "mem0",
    "qdrant",
    "memory",
    "agents",
    "llm",
    "vector-database",
    "react",
    "vite"
  ],
  "license": "MIT",
  "author": "dazeb",
  "homepage": "https://github.com/dazeb/mem0-viewer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dazeb/mem0-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/dazeb/mem0-viewer/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@fontsource/geist-mono": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@11.23.0"
}
